{
    "name": "artisan-build/laravel-cloud-client",
    "description": "A complete PHP SDK for the Laravel Cloud API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laravel-cloud",
        "sdk",
        "api-client",
        "saloon"
    ],
    "authors": [
        {
            "name": "Artisan Build",
            "email": "hello@artisan.build"
        }
    ],
    "require": {
        "php": "^8.1",
        "saloonphp/saloon": "^4.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "ArtisanBuild\\LaravelCloudClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArtisanBuild\\LaravelCloudClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ArtisanBuild\\LaravelCloudClient\\Providers\\LaravelCloudServiceProvider"
            ],
            "aliases": {
                "LaravelCloud": "ArtisanBuild\\LaravelCloudClient\\Facades\\LaravelCloud"
            }
        }
    },
    "scripts": {
        "refresh-api-spec": "@php ../../artisan cloud:api-spec:refresh",
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint",
        "quality": [
            "@format",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
